# .env do docker-compose.yml LOCAL (desenvolvimento). Copie para ".env" e preencha; ele nunca
# vai para o git nem para a imagem. No servidor nada disto e usado: os valores ficam no
# stack.yml e as senhas em secrets do Swarm (ver README, "Publicacao no servidor").
# O banco local (DB_HOST=db, cgv_dev) ja vem fixo no docker-compose.yml.

# SQL Server do Protheus - acesso direto via FreeTDS/pdo_dblib (sync e busca
# de colaborador do CDV). Conta de servico de dominio (NTLM): PROTHEUS_DB_USER
# e so o usuario, o dominio vai em PROTHEUS_DB_DOMAIN. Mesmos valores do SAF.
PROTHEUS_DB_HOST=
PROTHEUS_DB_PORT=1433
PROTHEUS_DB_NAME=
PROTHEUS_DB_DOMAIN=
PROTHEUS_DB_USER=
PROTHEUS_DB_PASSWORD=

# SMTP do botao de e-mail de beneficios/bene-intermitente.html (igual ao SAF).
# Porta 465 = SSL implicito.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NOME=CGV - Controle Geral de Volantes

# Login via AD (LDAP) e directory USC - vazios = so usuario local com senha
# propria. Producao: ldaps://ldap.empresa.com.br, 636.
LDAP_HOST=
LDAP_PORT=389
LDAP_DOMAIN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
USC_API_URL=
USC_API_TOKEN=

# Caminho do cobertura.json exportado pelo SAF (vazio = integracao desligada).
SAF_COBERTURA_JSON=

# Dias que o servico "backup" guarda os dumps em ./backups.
BACKUP_RETENCAO_DIAS=14
